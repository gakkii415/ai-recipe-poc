---
layout: null
permalink: /api/recipes.json
---
[
{% for post in site.posts %}
  {
    "content_id": {{ post.content_id | jsonify }},
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | prepend: site.url | jsonify }},
    "date": {{ post.date | date_to_xmlschema | jsonify }},
    "category": {{ post.category | jsonify }},
    "cuisine": {{ post.cuisine | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "prep_minutes": {{ post.prep_minutes | jsonify }},
    "cook_minutes": {{ post.cook_minutes | jsonify }},
    "servings": {{ post.servings | jsonify }},
    "difficulty": {{ post.difficulty | jsonify }},
    "ingredients": {{ post.ingredients | jsonify }},
    "generator": {{ post.generator | jsonify }},
    "prompt_version": {{ post.prompt_version | jsonify }},
    "batch_id": {{ post.batch_id | jsonify }},
    "review_status": {{ post.review_status | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]

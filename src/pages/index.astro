---
import { getCollection } from "astro:content"
import { RecipeExplorer, type RecipeSummary } from "@/components/RecipeExplorer"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { recipeUrl, sortRecipes } from "@/lib/recipes"
import { recipeImage } from "@/lib/recipe-images"

const recipes = sortRecipes((await getCollection("recipes")).filter((recipe) => recipe.data.published))
const summaries: RecipeSummary[] = recipes.map((recipe) => ({
  title: recipe.data.title,
  description: recipe.data.description,
  category: recipe.data.category,
  cuisine: recipe.data.cuisine,
  tags: recipe.data.tags,
  ingredients: recipe.data.ingredients,
  totalMinutes: recipe.data.prep_minutes + recipe.data.cook_minutes,
  url: recipeUrl(recipe),
  image: recipeImage(recipe.data),
}))
---
<BaseLayout title="レシピを探す" description="料理名・食材・調理時間からレシピを探す。気になる一皿は保存して、あとから見返せます。">
  <main id="main-content" class="browse-main site-width">
    <h1 class="sr-only">レシピを探す</h1>
    <section id="recipes" aria-labelledby="recipes-title">
      <RecipeExplorer recipes={summaries} client:load />
      <noscript>
        <h2 class="mt-8 text-xl font-semibold">全レシピ</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {summaries.map((recipe) => <li><a href={recipe.url} class="underline">{recipe.title}</a> · {recipe.totalMinutes}分</li>)}
        </ul>
      </noscript>
    </section>
  </main>
</BaseLayout>

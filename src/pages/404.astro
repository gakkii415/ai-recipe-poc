---
import { ArrowLeft } from "lucide-react"
import BaseLayout from "@/layouts/BaseLayout.astro"

const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<BaseLayout title="ページが見つかりません">
  <main id="main-content" class="mx-auto flex min-h-[65vh] max-w-6xl flex-col items-start justify-center px-4 py-20 sm:px-6">
    <p class="text-xs font-semibold tracking-[0.16em] text-primary">404 / NOT FOUND</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-6xl">ページが見つかりません。</h1>
    <a href={`${base}/`} class="mt-8 inline-flex h-9 items-center gap-2 rounded-md border bg-background px-3 text-sm font-medium shadow-xs hover:bg-accent">
      <ArrowLeft size={16} /> レシピ一覧へ戻る
    </a>
  </main>
</BaseLayout>


---
import { getCollection, render, type CollectionEntry } from "astro:content"
import { ArrowLeft, Clock3, Flame, Layers3, UsersRound } from "lucide-react"
import { RecipeActions } from "@/components/RecipeActions"
import BaseLayout from "@/layouts/BaseLayout.astro"
import { recipeSlug, recipeUrl, sortRecipes } from "@/lib/recipes"
import { recipeImage } from "@/lib/recipe-images"

export async function getStaticPaths() {
  const recipes = sortRecipes((await getCollection("recipes")).filter((recipe) => recipe.data.published))
  return recipes.map((recipe) => ({ params: { slug: recipeSlug(recipe) }, props: { recipe } }))
}
interface Props { recipe: CollectionEntry<"recipes"> }
const { recipe } = Astro.props
const { Content } = await render(recipe)
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const image = recipeImage(recipe.data)
const facts = [
  { label: "準備", value: `${recipe.data.prep_minutes}分`, icon: Clock3 },
  { label: "加熱", value: `${recipe.data.cook_minutes}分`, icon: Flame },
  { label: "分量", value: `${recipe.data.servings}人分`, icon: UsersRound },
  { label: "難易度", value: recipe.data.difficulty, icon: Layers3 },
]
const schema = {
  "@context": "https://schema.org", "@type": "Recipe",
  name: recipe.data.title, description: recipe.data.description,
  datePublished: recipe.data.date.toISOString(),
  prepTime: `PT${recipe.data.prep_minutes}M`, cookTime: `PT${recipe.data.cook_minutes}M`,
  recipeYield: `${recipe.data.servings}人分`, recipeCategory: recipe.data.category,
  recipeCuisine: recipe.data.cuisine, recipeIngredient: recipe.data.ingredients,
  ...(!image.reference ? { image: image.src } : {}),
}
---
<BaseLayout title={recipe.data.title} description={recipe.data.description}>
  <main id="main-content" class="recipe-detail site-width">
    <a href={`${base}/#recipes`} class="back-link"><ArrowLeft size={17} aria-hidden="true" />すべてのレシピ</a>
    <article>
      <header class="recipe-intro">
        <div class="recipe-intro-copy">
          <p class="detail-category">{recipe.data.category} · {recipe.data.cuisine}</p>
          <h1>{recipe.data.title}</h1>
          <p class="detail-description">{recipe.data.description}</p>
          <p class="detail-total"><Clock3 size={18} aria-hidden="true" />合計 <strong>{recipe.data.prep_minutes + recipe.data.cook_minutes}分</strong></p>
          <dl class="recipe-facts">{facts.map(({ label, value, icon: Icon }) => <div><dt><Icon size={15} aria-hidden="true" />{label}</dt><dd>{value}</dd></div>)}</dl>
          <RecipeActions url={recipeUrl(recipe)} title={recipe.data.title} client:load />
        </div>
        <figure class="detail-photo"><img src={image.src} alt={image.alt} width="720" height="540" loading="eager" decoding="async" referrerpolicy="no-referrer" />{image.reference && <figcaption>イメージ · 掲載レシピの完成写真ではありません</figcaption>}</figure>
      </header>
      <div class="recipe-reading-layout">
        <aside id="ingredients" class="ingredients-panel">
          <div class="ingredients-heading"><h2>材料</h2><span>{recipe.data.servings}人分</span></div>
          <ul class="ingredient-list">{recipe.data.ingredients.map((ingredient) => <li><label><input type="checkbox" /><span>{ingredient}</span></label></li>)}</ul>
        </aside>
        <div id="method" class="recipe-prose"><Content /></div>
      </div>
      <details class="recipe-audit"><summary>レシピの生成情報</summary><dl><div><dt>確認状況</dt><dd>{recipe.data.review_status}</dd></div><div><dt>記事ID</dt><dd>{recipe.data.content_id}</dd></div><div><dt>バッチ</dt><dd>{recipe.data.batch_id}</dd></div></dl></details>
    </article>
    <nav class="cooking-nav" aria-label="調理中のショートカット"><a href="#ingredients">材料を見る</a><a href="#method">作り方を見る</a></nav>
  </main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />
</BaseLayout>

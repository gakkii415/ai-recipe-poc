---
import { ChefHat, Heart, Utensils } from "lucide-react"
import "../styles/globals.css"
import "../styles/airbnb.css"

interface Props { title?: string; description?: string }
const { title, description = "料理名・材料から探せるレシピアーカイブ" } = Astro.props
const pageTitle = title ? `${title} — KITCHEN INDEX` : "KITCHEN INDEX"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <header class="site-header">
      <div class="site-width topbar">
        <a href={`${base}/`} class="site-brand" aria-label="KITCHEN INDEX ホーム"><ChefHat size={30} strokeWidth={1.7} aria-hidden="true" /><span>KITCHEN INDEX</span></a>
        <nav class="primary-nav" aria-label="メインナビゲーション"><a href={`${base}/#recipes`}><Utensils size={18} strokeWidth={1.7} aria-hidden="true" />レシピを探す</a></nav>
        <a href={`${base}/?saved=1#recipes`} class="header-saved" aria-label="保存したレシピを見る"><Heart size={19} strokeWidth={1.7} aria-hidden="true" /><span>保存したレシピ</span></a>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="site-width footer-inner"><div><strong>KITCHEN INDEX</strong><p>AI生成レシピの投稿検証サイト。調理内容は人による確認を前提としています。</p></div><nav aria-label="サイト情報"><a href={`${base}/POSTING_GUIDE/`}>投稿仕様</a><a href="https://github.com/gakkii415/ai-recipe-poc">GitHub</a><span data-version="9">v9</span></nav></div>
    </footer>
  </body>
</html>

---
import { ChefHat, ExternalLink } from "lucide-react"
import "../styles/globals.css"

interface Props {
  title?: string
  description?: string
}

const {
  title,
  description = "AIによる大量コンテンツ投稿を検証するレシピサイトPoC",
} = Astro.props
const pageTitle = title ? `${title} — KITCHEN INDEX` : "KITCHEN INDEX"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <header class="sticky top-0 z-50 border-b bg-background/90 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href={`${base}/`} class="flex items-center gap-2.5" aria-label="KITCHEN INDEX ホーム">
          <span class="flex size-8 items-center justify-center rounded-md bg-primary text-primary-foreground shadow-xs">
            <ChefHat size={17} strokeWidth={1.8} />
          </span>
          <span class="text-sm font-semibold tracking-[0.08em]">KITCHEN INDEX</span>
        </a>
        <nav class="flex items-center gap-1 text-sm font-medium" aria-label="メインナビゲーション">
          <a href={`${base}/#recipes`} class="rounded-md px-3 py-2 text-muted-foreground hover:bg-accent hover:text-foreground">レシピ</a>
          <a href={`${base}/POSTING_GUIDE/`} class="hidden rounded-md px-3 py-2 text-muted-foreground hover:bg-accent hover:text-foreground sm:block">投稿仕様</a>
          <a href="https://github.com/gakkii415/ai-recipe-poc" class="hidden items-center gap-1.5 rounded-md border bg-background px-3 py-2 shadow-xs hover:bg-accent sm:flex">
            GitHub <ExternalLink size={14} />
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t">
      <div class="mx-auto grid max-w-6xl gap-3 px-4 py-8 text-xs text-muted-foreground sm:grid-cols-[auto_1fr_auto] sm:items-center sm:px-6">
        <strong class="text-foreground">KITCHEN INDEX</strong>
        <span>AIによる大量コンテンツ投稿の技術検証サイトです。</span>
        <span>v7 · Astro + shadcn/ui v4</span>
      </div>
    </footer>
  </body>
</html>
